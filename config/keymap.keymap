#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans                        &trans               &trans              &trans     &trans                                      &trans            &trans  &trans     &trans   &trans         &trans
&trans  &kp Q                         &kp W                &kp E               &kp R      &kp T                                       &kp Y             &kp U   &kp I      &kp O    &kp BACKSPACE  &trans
&trans  &kp A                         &kp S                &kp D               &kp F      &kp G        &trans            &trans       &kp H             &kp J   &kp K      &kp L    &kp P          &trans
&trans  &kp Z                         &kp X                &kp C               &kp V      &kp B        &mkp MB4          &mkp LCLK    &kp N             &kp M   &kp COMMA  &kp DOT  &kp MINUS      &trans
&trans  &mt LEFT_CONTROL EXCLAMATION  &mt RIGHT_SHIFT TAB  &mt LEFT_ALT SPACE  &kp ENTER  &lt 2 LANG2  &lt 1 LANGUAGE_1  &lt 1 ENTER  &lt 2 INT_HENKAN  &trans  &trans     &mo 2    &kp QUESTION   &trans
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans            &trans            &trans            &trans            &trans                                   &trans         &trans      &trans            &trans         &trans           &trans
&trans  &kp F1            &kp F2            &kp F3            &kp F4            &kp F5                                   &kp F6         &kp F7      &kp F8            &kp F9         &kp F10          &trans
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)    &trans      &trans         &kp LS(N6)     &kp RS(N7)  &kp RS(NUMBER_8)  &kp RS(N9)     &none            &trans
&trans  &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4  &bt BT_CLR  &kp BACKSPACE  &none          &none       &kp RBKT          &kp BSLH       &kp PRINTSCREEN  &trans
&trans  &kp LEFT_CONTROL  &kp LSHIFT        &kp LEFT_ALT      &kp ENTER         &mo 2         &trans      &kp RET        &kp RIGHT_GUI  &trans      &trans            &kp SEMICOLON  &none            &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans           &trans   &trans        &trans   &trans                                   &trans            &trans           &trans    &trans     &trans         &trans
&trans  &kp TAB          &kp N7   &kp N8        &kp N9   &kp MINUS                                &kp LEFT_BRACKET  &kp RIGHT_SHIFT  &mkp MB4  &kp RA(Z)  &kp BACKSPACE  &trans
&trans  &kp KP_MULTIPLY  &kp N4   &kp N5        &kp N6   &kp RS(COLON)  &trans         &trans     &kp QMARK         &mkp LCLK        &kp UP    &mkp RCLK  &kp RC(C)      &trans
&trans  &kp SLASH        &kp N1   &kp N2        &kp N3   &none          &none          &none      &none             &kp LEFT         &kp DOWN  &kp RIGHT  &kp RC(V)      &trans
&trans  &none            &kp DOT  &kp NUMBER_0  &kp DEL  &trans         &kp BACKSPACE  &kp ENTER  &none             &trans           &trans    &trans     &kp RC(X)      &trans
            >;
        };
    };
};
